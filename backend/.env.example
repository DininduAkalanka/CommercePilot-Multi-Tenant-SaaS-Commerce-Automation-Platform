# ─────────────────────────────────────────────────────────────────
# CommercePilot Backend — Environment Variables
# Copy this file to .env and fill in all values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3001
APP_NAME=CommercePilot

# ─────────────────────────────────────────────────────────────────
# Database (Docker Postgres + pgvector)
# ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://commercepilot:commercepilot_dev_secret@localhost:5432/commercepilot_db?schema=public"
POSTGRES_USER=commercepilot
POSTGRES_PASSWORD=commercepilot_dev_secret
POSTGRES_DB=commercepilot_db

# ─────────────────────────────────────────────────────────────────
# Redis (Docker)
# ─────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────────
# JWT Authentication
# ─────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_USE_LONG_RANDOM_STRING_32_CHARS_MIN
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────────
# Application-layer Encryption (AES-256-GCM)
# Encrypts Restricted data at rest: WhatsApp / WooCommerce credentials.
# REQUIRED before storing real integration credentials.
# Generate a 32-byte key as 64 hex chars: openssl rand -hex 32
# Rotating this key makes previously-stored ciphertext undecryptable.
# ─────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_openssl_rand_hex_32

# ─────────────────────────────────────────────────────────────────
# Embeddings — selected separately from the text model, because the two
# come from different vendors (Groq has no embedding models at all).
# jina — free tier, no card, emits 768 dims to match products.embedding
# none — no embeddings; product search falls back to text matching
#
# NOTE: Jina handles English and Singlish well (Singlish->English scored
# 0.628, margin 0.322) but Sinhala SCRIPT scores as noise against real
# catalogue text. Normalise the query to English before embedding.
# ─────────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=none

# Get key at: https://jina.ai/embeddings
# 768 is required: products.embedding is vector(768) with an HNSW index
# built for that width. Jina defaults to 1024, which would fail inserts.
JINA_API_KEY=PASTE_YOUR_JINA_KEY_HERE
JINA_MODEL=jina-embeddings-v3
JINA_DIMENSIONS=768
JINA_MAX_ATTEMPTS=3
JINA_TIMEOUT_MS=30000

# ─────────────────────────────────────────────────────────────────
# AI provider selection
# groq   — free tier, no card, works in Sri Lanka. No embedding models,
#          so RAG product search falls back to text matching.
# gemini — has embeddings, but the free tier is region-gated and returns
#          `limit: 0` in Sri Lanka; needs a paid (card) account.
# ─────────────────────────────────────────────────────────────────
AI_PROVIDER=groq

# ─────────────────────────────────────────────────────────────────
# AI — Groq (free tier, no card required)
# Get key at: https://console.groq.com/keys
# ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=PASTE_YOUR_GROQ_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_ATTEMPTS=3
GROQ_TIMEOUT_MS=20000

# ─────────────────────────────────────────────────────────────────
# AI — Gemini Flash (free via Google AI Studio)
# Get key at: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_MAX_TOKENS=2048
GEMINI_TEMPERATURE=0.1

# ─────────────────────────────────────────────────────────────────
# Email — MailHog (dev, zero config)
# Web UI: http://localhost:8025
# ─────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=mailhog
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@commercepilot.dev
EMAIL_FROM_NAME=CommercePilot

# ─────────────────────────────────────────────────────────────────
# Email — Resend (production — swap EMAIL_PROVIDER to 'resend')
# ─────────────────────────────────────────────────────────────────
RESEND_API_KEY=YOUR_RESEND_KEY_WHEN_READY

# ─────────────────────────────────────────────────────────────────
# WhatsApp — Meta Cloud API (production)
# Leave blank to use the mock simulator
# ─────────────────────────────────────────────────────────────────
WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_WEBHOOK_VERIFY_TOKEN
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v18.0

# ─────────────────────────────────────────────────────────────────
# WooCommerce Integration — Mock adapter by default
# ─────────────────────────────────────────────────────────────────
WOOCOMMERCE_PROVIDER=mock

# ─────────────────────────────────────────────────────────────────
# Frontend URL (for email links, CORS)
# ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
