# ─────────────────────────────────────────────────────────────────
# CommercePilot Backend — PRODUCTION environment template
#
# These values are set in the RENDER DASHBOARD (Service → Environment), NOT in
# a committed file. This template documents what each one should look like.
# Never commit real secrets.
# ─────────────────────────────────────────────────────────────────

NODE_ENV=production
APP_NAME=CommercePilot
# PORT is injected by Render automatically — do NOT set it.

# ── Database — Neon (pooled connection string; sslmode=require is required) ──
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ── Redis — Upstash (rediss:// auto-enables TLS) ─────────────────────────────
REDIS_URL="rediss://default:PASSWORD@your-db-name.upstash.io:6379"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_64_HEX_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Application-layer encryption (AES-256-GCM) ───────────────────────────────
# Generate with:  openssl rand -hex 32   (rotating this makes old ciphertext unreadable)
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS

# ── Frontend origin (Vercel) — used for CORS and email links ─────────────────
FRONTEND_URL=https://your-app.vercel.app

# ── Integrations — stay in mock mode for the demo ────────────────────────────
WHATSAPP_PROVIDER=mock
WOOCOMMERCE_PROVIDER=mock

# ── AI — leave unset to use the free built-in mock extractor ─────────────────
# GEMINI_API_KEY=

# ── Email — optional ─────────────────────────────────────────────────────────
# 'mailhog' with no reachable SMTP = outbound email disabled (fails gracefully,
# never crashes). For real delivery, set EMAIL_PROVIDER=resend and the SMTP_*
# values to a free provider (see DEPLOYMENT.md → "Optional: real emails").
EMAIL_PROVIDER=mailhog

# ── Error tracking — optional (see DEPLOYMENT.md → "Optional: Sentry") ───────
# SENTRY_DSN=
